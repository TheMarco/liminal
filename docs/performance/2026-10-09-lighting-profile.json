{
  "date": "2026-10-09",
  "scope": "Performance review only; no production lighting or quality settings changed.",
  "device": "Apple M3 Max / Metal / Godot 4.7.2",
  "method": "High / Clean, 1152x720 world in 1440x900 output. Seed 240721. Unique room-complete neighbourhoods. Six batches of 30 forced frames per diagnostic, fenced by image readback. Current lighting measured before and after each sequence; reduction ranges use both baselines. All GPU jobs ran sequentially.",
  "limitations": [
    "Static renderer throughput, not gameplay FPS; scripts, streaming and moving-camera frame pacing are not covered. Renderer-time shader and particle effects may still advance.",
    "GPU timestamp queries returned zero and are unavailable. Ordinary frames were sometimes suppressed when the native window was not rendering; ignore interval/CPU timestamp fields where ordinary_timing_valid is false or absent. Forced draws explicitly validated in Bloom and subsequent runs.",
    "Airport baseline drift was about 12% in the room-only trial, so results are reported as a range rather than exact projected savings. Compare paired runs rather than treating previous-day absolute timings as identical conditions.",
    "One representative view per affected level on one GPU. No claim for all variants, lower-tier hardware, or VHS/CRT processing.",
    "Existing native harness shutdown warnings about 7 texture RIDs and 1 ObjectDB instance occurred in several runs; no parse, shader or measurement-assertion errors."
  ],
  "findings": [
    {
      "priority": 1,
      "area": "Upward light ranges",
      "finding": "5 m instead of 9 m reduces shadow/lighting overlap while leaving downward floor-light reach intact. Measured about 9\u201316% lower render time across School, Mall and Bloom.",
      "next_step": "Tune per fixture height and ceiling layout; verify brightness, walls, doorways, floor reflections and moving-camera transitions before adopting."
    },
    {
      "priority": 2,
      "area": "Airport light visibility",
      "finding": "Loaded neighbourhood contains 304 coffer lights and 48 panel lights. Room-only diagnostic reduces measured cost from 34.9\u201339.0 ms to 22.6 ms.",
      "next_step": "Implement conservative room/portal-aware light and receiver culling. Retain neighbouring sources that can contribute through doors or to visible reflections. The diagnostic itself is not shippable."
    },
    {
      "priority": 3,
      "area": "Bloom shadow geometry",
      "finding": "Observed shadow-inclusive baseline workload is about 5,800 draws and 15 million primitives. Removing small-object shadows alone saved roughly 9%; full shadow removal saved roughly 34% but violates occlusion requirements.",
      "next_step": "Investigate simpler shadow-only geometry and batching for organic props, retaining wall blocking and full visible meshes. Proxy savings are not yet measured."
    },
    {
      "priority": 4,
      "area": "Preserve reflections",
      "finding": "Disabling SSR/probes yielded approximately 0\u20134% improvement in these samples. Airport specular-off test also showed only a small change. Neither is a good first quality tradeoff.",
      "next_step": "Keep floor gloss and reflection features; optimize the number of unnecessary lighting/shadow evaluations."
    }
  ],
  "rejected_candidate": "Reducing every downward range to 70% and uplights to 3 m saved 27\u201340%, but dimmed ceilings and removed valid Mall floor reflections. Do not apply this blanket change.",
