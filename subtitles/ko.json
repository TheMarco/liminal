  "res://videos/intro/photo_tutorial.ogv": [
    {
      "start": 0,
      "end": 3.24,
      "text": "어울리지 않는 것, 불가능한 것을 사진으로 남겨요."
    },
    {
      "start": 3.82,
      "end": 6.56,
      "text": "발길을 멈추고 정말 본 게 맞나 싶게 하는 모든 것을요."
    },
    {
      "start": 7.36,
      "end": 9.58,
      "text": "나 자신을 위해 이곳을 기록한다고 생각했어요."
    },
    {
      "start": 11.16,
      "end": 12.22,
      "text": "틀렸어요."
    },
    {
      "start": 13.36,
      "end": 15.16,
      "text": "엘리베이터는 늘 오지는 않아요."
    },
    {
      "start": 16.06,
      "end": 18.88,
      "text": "하지만 이런 이상 현상을 충분히 찍고 나면,"
    },
    {
      "start": 19.72,
      "end": 20.38,
      "text": "와요."
    },
    {
      "start": 21.96,
      "end": 24.16,
      "text": "출구를 찾으라는 게 아니에요."
    },
    {
      "start": 25.04,
      "end": 27.26,
      "text": "주의를 기울이고 있었다는 걸 증명하라는 거예요."
    },
    {
      "start": 28.36,
      "end": 29.04,
      "text": "그러니 잘 살펴봐요."
    }
  ],
  "res://videos/tapes/short_beginning_00.ogv": [
    {
      "start": 0.18,
      "end": 2.56,
      "text": "불이 꺼지면 움직이지 마요."
    },
    {
      "start": 3.1,
      "end": 3.86,
      "text": "뒤돌아보지 마요."
    },
    {
      "start": 4.3,
      "end": 5.46,
      "text": "벽을 찾으려 하지도 마요."
    },
    {
      "start": 5.8,
      "end": 7.4,
      "text": "그 자리에 그대로 있어요."
    },
    {
      "start": 9.66,
      "end": 12.28,
      "text": "어둠이 내게 뭔가를 숨긴다고 생각했어요."
