    {
      "start": 14.26,
      "end": 15.16,
      "text": "이젠 아니에요."
    },
    {
      "start": 17.78,
      "end": 19.98,
      "text": "어두울 때 그것이 물건을 옮기는 것 같아요."
    },
    {
      "start": 22.95,
      "end": 27.25,
      "text": "당신까지 움직이면, 당신을 어디에 둘지도 정해야겠죠."
    }
  ],
  "res://videos/tapes/short_beginning_01.ogv": [
    {
      "start": 0.02,
      "end": 1.68,
      "text": "그 형체들에 대해 생각해 봤어요."
    },
    {
      "start": 2.84,
      "end": 5.74,
      "text": "다가온다는 이유로 우릴 사냥한다고 생각하죠."
    },
    {
      "start": 6.22,
      "end": 7.02,
      "text": "그럴 만해요."
    },
    {
      "start": 8.28,
      "end": 9.56,
      "text": "하지만 먹는 모습은 본 적 없어요."
