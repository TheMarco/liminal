  "res://videos/tapes/tape_02.ogv": [
    {
      "start": 0.21,
      "end": 1.49,
      "text": "첫 번째 기록."
    },
    {
      "start": 2.99,
      "end": 4.71,
      "text": "3월 14일, 금요일."
    },
    {
      "start": 4.87,
      "end": 8.37,
      "text": "밤 11시 40분. 내 시계가 맞는다면. 늘 맞지만."
    },
    {
      "start": 9.97,
      "end": 10.43,
      "text": "나는,"
    },
    {
      "start": 10.43,
      "end": 12.01,
      "text": "에벌린 크로스 박사. 기록을 위해 밝혀 둡니다."
    },
    {
      "start": 12.73,
      "end": 14.83,
      "text": "누구를 위한 기록인지는 아직 모르겠어요."
    },
    {
      "start": 15.13,
      "end": 16.69,
      "text": "화물용 엘리베이터를 타고 내려왔어요."
    },
    {
      "start": 16.91,
      "end": 19.13,
      "text": "어떤 지하실도 있을 수 없을 만큼 오래 내려갔어요."
    },
    {
      "start": 19.61,
      "end": 21.31,
      "text": "문이 열리자 공간이 있었어요."
    },
    {
      "start": 21.99,
      "end": 26.05,
      "text": "카펫, 조명, 전력. 모두 작동하고 관리되고 있었지만, 사람은,"
    },
    {
      "start": 26.05,
      "end": 26.55,
      "text": "어디에도 없었어요."
    },
    {
      "start": 27.09,
      "end": 28.45,
      "text": "두 번 소리쳐 봤어요."
    },
    {
      "start": 29.23,
      "end": 29.91,
      "text": "아무 답도 없었어요."
    },
    {
      "start": 30.43,
      "end": 32.57,
      "text": "가장 간단한 설명은 미등록 건축물이죠."
    },
    {
      "start": 33.05,
      "end": 36.55,
      "text": "오래된 기초, 봉쇄된 층. 도시는 늘 뭔가를 묻으니까요."
    },
    {
      "start": 37.21,
      "end": 41.17,
      "text": "그런데 20분을 똑바로 걸어도 외벽에 닿지 않았어요."
    },
    {
      "start": 41.17,
      "end": 43.11,
      "text": "위쪽 건물의 폭은 80미터인데요."
    },
    {
      "start": 43.93,
      "end": 44.85,
      "text": "직접 쟀어요."
    },
    {
      "start": 45.35,
      "end": 48.57,
      "text": "그러니 그 설명은 틀렸고, 더 나은 설명은 아직 없어요."
    },
    {
      "start": 48.83,
      "end": 49.41,
      "text": "괜찮아요."
    },
    {
      "start": 49.71,
      "end": 51.37,
      "text": "대부분, 대부분의 설명은 틀린 채로 시작하니까요."
    },
    {
      "start": 51.77,
      "end": 53.77,
      "text": "확인할 수 있는 모든 것을 기록하겠어요."
    },
    {
      "start": 53.77,
      "end": 56.13,
      "text": "누군가 이 기록을 찾는다면,"
    },
    {
      "start": 56.79,
      "end": 57.95,
      "text": "내가 시작한 곳에서 시작해요."
    }
  ],
  "res://videos/tapes/tape_03.ogv": [
    {
      "start": 0,
      "end": 0.88,
      "text": "여섯 번째 기록."
    },
    {
      "start": 1.34,
      "end": 2.1,
      "text": "여섯 번째일 거예요."
    },
    {
      "start": 3.16,
      "end": 4.86,
      "text": "어쨌든 남길 만한 것 중 여섯 번째죠."
    },
    {
      "start": 6.36,
      "end": 8.3,
      "text": "15일 토요일."
    },
    {
      "start": 9.18,
      "end": 11.42,
      "text": "마지막으로 확인했을 땐 15일이었어요."
    },
    {
      "start": 11.64,
      "end": 14.52,
      "text": "확인한 지 너무 오래됐다는 건 인정해요."
    },
    {
      "start": 15.3,
      "end": 16.82,
      "text": "여기선 모든 것이 여전히 제 일을 해요."
    },
    {
      "start": 17.62,
      "end": 18.86,
      "text": "조명이 정해진 시간에 바뀌어요."
    },
    {
      "start": 19.58,
      "end": 20.92,
      "text": "아무도 듣지 않는 음악이 흘러요."
    },
    {
      "start": 21.14,
      "end": 22.82,
      "text": "이젠 반복 순서도 알 것 같아요."
    },
    {
      "start": 23.48,
      "end": 25.72,
      "text": "오늘 아침엔 기계가 내게 잔돈을 내줬어요."
    },
    {
      "start": 26.22,
      "end": 27.04,
      "text": "정확한 액수였어요."
    },
    {
      "start": 27.04,
      "end": 29.9,
      "text": "그런데 돈을 낼 사람은 어디에도 없었어요."
    },
    {
      "start": 30.4,
      "end": 31.58,
      "text": "처음엔 버려진 곳이라고 생각했어요."
    },
    {
      "start": 32.16,
      "end": 34.92,
      "text": "사람들이 급히 떠나고 설비만 계속 돌아간다고요."
    },
    {
      "start": 35.54,
      "end": 36.58,
      "text": "마음 편한 가설이죠."
    },
    {
      "start": 37.24,
      "end": 38.6,
      "text": "하지만 버려진 곳은 낡아요."
    },
    {
      "start": 39.2,
      "end": 41.82,
      "text": "먼지, 습기, 고장. 여긴 아무것도 낡지 않아요."
    },
    {
      "start": 43.0,
      "end": 44.66,
      "text": "한 번도 그러도록 허락된 적이 없어요."
    },
    {
      "start": 45.34,
      "end": 47.86,
      "text": "사용되는 연습을 하는 곳에 더 가까워요."
    },
    {
      "start": 48.8,
      "end": 53.2,
      "text": "오지 않는 사람들을 위해 끝없이 연습하는 거죠. 그렇다면,"
    },
    {
      "start": 53.2,
      "end": 54.36,
      "text": "애초에 아무도 산 적이 없다는 뜻이에요."
    },
    {
      "start": 54.42,
      "end": 55.42,
      "text": "증명할 수는 없어요."
    },
    {
      "start": 55.44,
      "end": 57.7,
      "text": "증명할 수 없다는 점은 기록에 분명히 남기고 싶어요."
    }
  ],
  "res://videos/tapes/tape_04.ogv": [
    {
      "start": 0,
      "end": 3.44,
      "text": "아홉 번째 기록. 17일 월요일."
    },
    {
      "start": 3.5,
      "end": 4.52,
      "text": "지도를 그리기 시작했어요."
    },
    {
      "start": 5.46,
      "end": 9.64,
      "text": "방, 갈림길, 거리, 엘리베이터를 부른 뒤 도착하기까지 걸리는,"
    },
    {
      "start": 9.64,
      "end": 10.14,
      "text": "시간."
    },
    {
      "start": 10.56,
      "end": 14.28,
      "text": "이곳에 규칙이 있다면, 있다고 믿지만, 그것은,"
    },
    {
      "start": 14.28,
      "end": 14.78,
      "text": "숫자에 드러날 거예요."
    },
    {
      "start": 15.2,
      "end": 17.48,
      "text": "여기서 믿을 수 있는 건 엘리베이터뿐이에요."
    },
    {
      "start": 18.12,
      "end": 20.92,
      "text": "부르면 오고, 갈 곳으로 가요."
    },
    {
      "start": 21.08,
      "end": 24.14,
      "text": "한 번도 날 겁준 적 없어요. 다른 것들은 그렇지 않아요."
    },
    {
      "start": 24.64,
      "end": 27.64,
      "text": "마흔 번 쟀어요. 마흔 번 모두 같았어요."
    },
    {
      "start": 27.64,
      "end": 28.58,
      "text": "문제는,"
    },
    {
      "start": 30.41,
      "end": 31.81,
      "text": "내 뒤에 있어요."
    },
    {
      "start": 32.51,
      "end": 36.21,
      "text": "복도를 걷고, 그리고, 같은 길로 돌아오면 그림이,"
    },
    {
      "start": 36.21,
      "end": 36.71,
      "text": "틀려 있어요."
    },
    {
      "start": 37.11,
      "end": 38.07,
      "text": "크게 틀리진 않아요."
    },
    {
      "start": 38.47,
      "end": 39.41,
      "text": "절대 크게 틀리진 않아요."
    },
    {
      "start": 39.87,
      "end": 43.19,
      "text": "문이 하나 적거나, 모퉁이가 기록보다 일찍 나와요."
    },
    {
      "start": 43.47,
      "end": 44.85,
      "text": "작고, 부정할 수 있는 오차들."
    },
    {
      "start": 45.47,
      "end": 48.79,
      "text": "내가 안 볼 때 이곳이 스스로 바뀌거나, 측정 도구인 내가,"
    },
    {
      "start": 48.79,
      "end": 51.93,
      "text": "망가지고 있거나. 어느 쪽이 더 무서운지 모르겠어요."
    },
    {
      "start": 53.25,
      "end": 55.17,
      "text": "그래도 계속 지도를 그려요."
    },
    {
      "start": 56.35,
      "end": 59.41,
      "text": "지도는 틀렸지만, 멈추는 게 더 두려워요."
    }
  ],
  "res://videos/tapes/tape_05.ogv": [
    {
      "start": 0,
      "end": 0.54,
      "text": "기록."
    },
    {
      "start": 1.52,
      "end": 2.92,
      "text": "번호 붙이는 건 그만뒀어요."
    },
    {
      "start": 3.26,
      "end": 6.6,
      "text": "20일 아니면 22일이에요."
    },
    {
      "start": 6.92,
      "end": 10.82,
      "text": "시계와 메모가 서로 달라요. 둘 다 믿었는데."
    },
    {
      "start": 11.42,
      "end": 13.86,
      "text": "일하는 내내 둘 다 믿어 왔어요."
    },
    {
      "start": 14.88,
      "end": 16.84,
      "text": "확실히 말할 수 있는 건 이거예요."
    },
    {
      "start": 17.22,
      "end": 21.6,
      "text": "카메라는 마지막 녹화가 19시간 전이라는데, 몸은 며칠이 지났대요."
    },
    {
      "start": 22.44,
      "end": 26.0,
      "text": "그동안 네 번 먹고 두 번 잤어요. 아마도."
    },
    {
      "start": 26.92,
      "end": 29.68,
      "text": "그 숫자들은 같은 19시간 안에 들어갈 수 없어요."
    },
    {
      "start": 30.3,
      "end": 34.38,
      "text": "19시간에 담을 수 없을 만큼 걸은 기억도 있어요. 몇 시간이나 되는 복도가,"
    },
    {
      "start": 34.38,
      "end": 35.52,
      "text": "아직도 눈에 선해요."
    },
    {
      "start": 36.52,
      "end": 40.58,
      "text": "엘리베이터가 거리를 따라 내려간다고 생각했어요. 실재하는 무언가의,"
    },
    {
      "start": 40.58,
      "end": 41.66,
      "text": "층을 지나서."
    },
    {
      "start": 42.36,
      "end": 44.86,
      "text": "이젠 거리를 통과하는 게 아닌 것 같아요."
    },
    {
      "start": 45.22,
      "end": 47.8,
      "text": "그 대신 뭘 통과하는지에 대한 증거는 없어요."
    },
    {
      "start": 48.64,
      "end": 49.14,
      "text": "전혀."
    },
    {
      "start": 49.54,
      "end": 51.96,
      "text": "다른 말을 하기 전에 그 점을 기록해 두고 싶어요."
    },
    {
      "start": 52.72,
      "end": 53.66,
      "text": "느낌이에요."
    },
    {
      "start": 53.9,
      "end": 54.86,
      "text": "그게 전부예요."
    },
    {
      "start": 55.46,
      "end": 59.8,
      "text": "그리고 요즘엔 사실보다 느낌이 먼저 찾아와요."
    }
  ],
  "res://videos/tapes/tape_43.ogv": [
    {
      "start": 0,
      "end": 2.02,
      "text": "오늘 기억 속의 방을 찾았어요."
    },
    {
      "start": 2.62,
      "end": 3.46,
      "text": "낯익은 게 아니라,"
    },
    {
      "start": 4.2,
      "end": 4.76,
      "text": "기억하고 있었어요."
    },
    {
      "start": 5.72,
      "end": 8.54,
      "text": "세 번째 책상의 흠집. 낚싯바늘 모양."
    },
    {
      "start": 9.1,
      "end": 11.36,
      "text": "문 옆 옷걸이 고리. 하나가 위로 휘어 있어요."
    },
    {
      "start": 12.02,
      "end": 13.74,
      "text": "보기 전부터 알고 있었어요."
    },
    {
      "start": 15.15,
      "end": 18.37,
      "text": "문을 열기 전에도 그 방을 그릴 수 있었을 거예요. 창문으로 들어오는,"
    },
    {
      "start": 18.37,
      "end": 19.19,
      "text": "빛까지도."
    },
    {
      "start": 20.15,
      "end": 24.05,
      "text": "난 그 방이 있을 법한 곳에서 600마일이나 떨어져 자랐어요."
    },
    {
      "start": 25.13,
      "end": 27.25,
      "text": "확인하려고 메모를 두 번이나 읽었어요."
    },
    {
      "start": 29.98,
      "end": 31.72,
      "text": "내 어린 시절은 다른 곳에 있었어요."
    },
    {
      "start": 31.76,
      "end": 33.98,
      "text": "나에 대한 사실인데, 확인해야 했어요."
    },
    {
      "start": 34.36,
      "end": 36.4,
      "text": "잠시 그 의미를 생각해 봐요. 나는 그랬어요."
    },
    {
      "start": 41.88,
      "end": 45.42,
      "text": "이곳이 내 머릿속을 읽어 만들어 내거나, 아니면,"
    },
    {
      "start": 45.42,
      "end": 48.82,
      "text": "무언가를 써넣고 있고, 내 기억이 공사 현장인 거예요."
    },
    {
      "start": 49.3,
      "end": 50.24,
      "text": "어느 쪽인지 몰라요."
    },
    {
      "start": 50.62,
      "end": 51.62,
      "text": "알 수도 없어요."
    },
    {
      "start": 51.96,
      "end": 53.08,
      "text": "그래서 가능한 거예요."
    },
    {
      "start": 53.66,
      "end": 55.74,
      "text": "예전엔 어떤 기억이 내 것인지 알았어요."
    },
    {
      "start": 56.56,
      "end": 58.42,
      "text": "그 말이 과거형이어선 안 되는데."
    }
  ],
  "res://videos/tapes/tape_44.ogv": [
    {
      "start": 0.05,
      "end": 1.45,
      "text": "이번엔 실용적인 이야기예요."
    },
    {
      "start": 2.29,
      "end": 5.15,
      "text": "날 따라오고 있다면, 끝나면 테이프를 멈추고 다시 봐요."
    },
    {
      "start": 6.11,
      "end": 7.47,
      "text": "여기엔 다른 존재들이 있어요."
    },
    {
      "start": 7.93,
      "end": 9.53,
      "text": "아마 지금쯤 하나는 봤겠죠."
    },
    {
      "start": 10.11,
      "end": 11.97,
      "text": "아직 못 봤다면, 곧 보게 될 거예요."
    },
    {
      "start": 15.28,
      "end": 18.16,
      "text": "모습은 설명하지 않을게요. 내 설명이 정확할지 모르니까요."
    },
    {
      "start": 18.16,
      "end": 20.42,
      "text": "부정확한 설명은 사람을 다치게 해요."
    },
    {
      "start": 20.9,
      "end": 25.96,
      "text": "확인한 건 이거예요. 거리와 출입구는 시간을 벌어 주지만,"
    },
    {
      "start": 25.96,
      "end": 26.54,
      "text": "안전을 보장하진 않아요."
    },
    {
      "start": 27.5,
      "end": 29.54,
      "text": "살아 있는 것처럼 흥미를 잃지도 않아요."
    },
    {
      "start": 29.54,
      "end": 30.36,
      "text": "빛."
    },
    {
      "start": 31.02,
      "end": 32.44,
      "text": "내 휴대전화의 빛."
    },
    {
      "start": 32.94,
      "end": 34.08,
      "text": "그 빛 안으론 들어오지 않아요."
    },
    {
      "start": 34.3,
      "end": 35.92,
      "text": "빛 가장자리에 서서 기다려요."
    },
    {
      "start": 36.46,
      "end": 38.74,
      "text": "하지만 충분히 오래 비추면, 물러나는 게 아니라,"
    },
    {
      "start": 39.28,
      "end": 39.9,
      "text": "끝나요."
    },
    {
      "start": 40.32,
      "end": 41.3,
      "text": "직접 봤어요."
    },
    {
      "start": 43.38,
      "end": 44.56,
      "text": "내가 그렇게 만들었어요."
    },
    {
      "start": 45.35,
      "end": 47.43,
      "text": "전에는 그것들에 대해 다른 걸 믿었어요."
    },
    {
      "start": 47.83,
      "end": 48.61,
      "text": "그럴듯한 것이었죠."
    },
    {
      "start": 49.21,
      "end": 51.77,
      "text": "지금처럼 사실로 기록했어요."
    },
    {
      "start": 53.21,
      "end": 56.35,
      "text": "틀렸어요. 그리고 대가를 치른 건 내가 아니었어요."
    },
    {
      "start": 57.25,
      "end": 58.79,
      "text": "필요해지기 전에 손전등을 확인해요."
    },
    {
      "start": 58.79,
      "end": 59.87,
      "text": "그 후가 아니라."
    }
  ],
  "res://videos/tapes/tape_45.ogv": [
    {
      "start": 0,
      "end": 3.42,
      "text": "설명들을 순서대로 적어 두었어요."
    },
    {
      "start": 3.6,
      "end": 6.16,
      "text": "더는 짊어지지 않으려고 소리 내 읽어요."
    },
    {
      "start": 6.7,
      "end": 7.56,
      "text": "사후 세계."
    },
    {
      "start": 9.02,
      "end": 10.84,
      "text": "어딘가에 실제로 존재하는 건축물."
    },
    {
      "start": 11.48,
      "end": 14.86,
      "text": "전혀 다른 곳의, 고유한 규칙을 가진 꿈."
    },
    {
      "start": 15.46,
      "end": 17.42,
      "text": "모두 한동안은 증거에 들어맞았어요."
    },
    {
      "start": 17.52,
      "end": 18.6,
      "text": "하나도 빠짐없이."
    },
    {
      "start": 18.66,
      "end": 19.42,
      "text": "그게 문제예요."
    },
    {
      "start": 20.24,
      "end": 23.94,
      "text": "가설을 받아들이는 순간, 이곳이 그 증거를 만들어 냈어요."
    },
    {
      "start": 24.24,
      "end": 24.86,
      "text": "아낌없이."
    },
    {
      "start": 25.38,
      "end": 25.96,
      "text": "풍성하게."
    },
    {
      "start": 26.62,
      "end": 29.26,
      "text": "내게 동의하며 즐기는 것처럼."
    },
    {
      "start": 30.02,
      "end": 33.92,
      "text": "내 생각을 뒷받침하는 것만 보는, 잘못된 측정 도구이거나,"
    },
    {
      "start": 34.46,
      "end": 35.68,
      "text": "신뢰할 수 없는 도구이거나,"
    },
    {
      "start": 36.6,
      "end": 41.42,
      "text": "아니면 이곳이 믿음에 증거로 답하거나. 그게 더 나빠요. 그렇다면,"
    },
    {
      "start": 41.42,
      "end": 44.92,
      "text": "내가 찾은 모든 답이 나를 위해 주문대로 자란 거니까요."
    },
    {
      "start": 45.24,
      "end": 46.42,
      "text": "그래서 설명을 그만뒀어요."
    },
    {
      "start": 47.34,
      "end": 48.7,
      "text": "관찰을 그만둔 건 아니에요."
    },
    {
      "start": 48.84,
      "end": 52.38,
      "text": "여전히 세고, 재고, 기록하지만 설명은 하지 않아요."
    },
    {
      "start": 53.8,
      "end": 57.4,
      "text": "그 둘은 달라요. 그 차이가,"
    },
    {
      "start": 57.4,
      "end": 59.0,
      "text": "지금까지 날 살게 한 것 같아요."
    }
  ],
  "res://videos/tapes/tape_46.ogv": [
    {
      "start": 0,
      "end": 0.88,
      "text": "날짜 없음."
    },
    {
      "start": 1.56,
      "end": 5.16,
      "text": "날짜는 놓아 버렸어요. 놓는 게 기억하는 것보다 훨씬,"
    },
    {
      "start": 5.16,
      "end": 5.72,
      "text": "쉬웠어요."
    },
    {
      "start": 6.7,
      "end": 8.06,
      "text": "새로 보고할 게 있어요."
    },
    {
      "start": 8.92,
      "end": 11.32,
      "text": "이젠 다음 장소에 도착하기 전에 그 소리가 들려요."
    },
    {
      "start": 11.92,
      "end": 12.66,
      "text": "며칠 전부터요."
    },
    {
      "start": 13.42,
      "end": 14.64,
      "text": "미리 새어 들어와요."
    },
    {
      "start": 15.48,
      "end": 16.68,
      "text": "이번엔 물이었어요."
    },
    {
      "start": 17.26,
      "end": 21.12,
      "text": "처음엔 벽 뒤 어딘가의 물방울. 다음엔 흐르는 물."
    },
    {
      "start": 22.16,
      "end": 25.88,
      "text": "그다음엔 냄새. 내가 지날 땐 바싹 말라 있던 방에서요."
    },
    {
      "start": 26.52,
      "end": 29.92,
      "text": "엘리베이터가 왔을 땐 물은 이미 사실이었어요."
    },
    {
      "start": 30.44,
      "end": 34.04,
      "text": "예전엔 서로 다른 장소가 위아래로 쌓여 있다고 생각했어요. 그리고,"
    },
    {
      "start": 34.04,
      "end": 36.06,
      "text": "엘리베이터가 그 사이의 이음매라고요."
    },
    {
      "start": 36.74,
      "end": 38.4,
      "text": "이젠 이음매가 무너지고 있는 것 같아요."
    },
    {
      "start": 39.22,
      "end": 41.24,
      "text": "아니면 처음부터 이음매는 없었거나."
    },
    {
      "start": 41.84,
      "end": 44.58,
      "text": "한 장소가 다른 방들을 걸치고 있는 거예요."
    },
    {
      "start": 45.48,
      "end": 46.82,
      "text": "어느 것도 증명할 수 없어요."
    },
    {
      "start": 47.52,
      "end": 49.98,
      "text": "테이프마다 그 말을 한다는 걸 깨달아요."
    },
    {
      "start": 50.24,
      "end": 51.34,
      "text": "증명할 수 없어요."
    },
    {
      "start": 52.02,
      "end": 55.16,
      "text": "예전만큼 신경 쓰이지 않아요. 그것도 걱정해야 할,"
    },
    {
      "start": 55.16,
      "end": 55.66,
      "text": "일이겠죠."
    },
    {
      "start": 56.34,
      "end": 57.1,
      "text": "그런데 그렇지 않아요."
    }
  ],
  "res://videos/tapes/tape_47.ogv": [
    {
      "start": 0.14,
      "end": 1.62,
      "text": "오늘 테이프들을 찾았어요."
    },
    {
      "start": 2.14,
      "end": 3.16,
      "text": "서랍 하나 가득."
    },
    {
      "start": 3.64,
      "end": 5.98,
      "text": "내 목소리, 내 방. 이 방, 이 탁자."
    },
    {
      "start": 6.94,
      "end": 8.76,
      "text": "녹화한 기억은 없어요."
    },
    {
      "start": 9.22,
      "end": 11.22,
      "text": "그것만이라면 피로 탓으로 돌릴 수 있어요."
    },
    {
      "start": 11.84,
      "end": 13.96,
      "text": "요즘은 더 심한 것도 피로 탓으로 돌렸어요."
    },
    {
      "start": 15.56,
      "end": 17.94,
      "text": "하나엔 아직 하지 않은 말이 담겨 있어요."
    },
    {
      "start": 18.5,
      "end": 20.26,
      "text": "오늘 밤 하려던 말들."
    },
    {
      "start": 20.6,
      "end": 24.72,
      "text": "이 기록에서. 아직 고르지 않은 말들로. 테이프를 두 번 확인했어요."
    },
    {
      "start": 24.72,
      "end": 25.94,
      "text": "녹화 버튼을 누르기 전에."
    },
    {
      "start": 25.94,
      "end": 27.04,
      "text": "그건,"
    },
    {
      "start": 28.43,
      "end": 29.53,
      "text": "바로 여기 있어요."
    },
    {
      "start": 30.81,
      "end": 32.19,
      "text": "그러니 대신 당신에게 말할게요."
    },
    {
      "start": 33.05,
      "end": 34.37,
      "text": "내 뒤에 있는 누군가에게."
    },
    {
      "start": 35.25,
      "end": 39.17,
      "text": "내가 볼 수 없는 곳에 앉아, 내가 그녀의 것을 봤듯 이걸 보는 누군가에게."
    },
    {
      "start": 40.43,
      "end": 40.93,
      "text": "내 것."
    },
    {
      "start": 42.27,
      "end": 44.79,
      "text": "당신은 내가 아직 무너뜨리지 못한 유일한 가설이에요."
    },
    {
      "start": 45.43,
      "end": 49.03,
      "text": "당신에게 경고를 남기는 건지, 내게 남겨진 경고를 되풀이하는 건지,"
    },
    {
      "start": 49.03,
      "end": 51.69,
      "text": "모르겠어요. 이 문장까지 한 글자도 빠짐없이."
    },
    {
      "start": 52.47,
      "end": 55.69,
      "text": "그 차이가 나 말고 누구에게 의미가 있을지 이젠 모르겠어요."
    },
    {
      "start": 56.13,
      "end": 57.81,
      "text": "처음부터 의미가 없었을지도요."
    }
  ],
  "res://videos/tapes/tape_48.ogv": [
    {
      "start": 0.05,
      "end": 2.23,
      "text": "당신에게 설명을 해 주진 않을 거예요."
    },
    {
      "start": 3.09,
      "end": 4.19,
      "text": "내게도 없으니까요."
    },
    {
      "start": 4.95,
      "end": 8.45,
      "text": "그걸 슬퍼하는 건 그만뒀어요. 생각보다 오래 걸렸죠."
    },
    {
      "start": 10.5,
      "end": 14.34,
      "text": "마지막으로 남길 기록이니, 분명하게 말할게요."
    },
    {
      "start": 15.56,
      "end": 19.86,
      "text": "여기 있다면, 다른 모든 것이 되려고 했던 곳에,"
    },
    {
      "start": 19.86,
      "end": 20.36,
      "text": "도착한 거예요."
    },
    {
      "start": 21.74,
      "end": 23.96,
      "text": "겁주려는 말이 아니에요."
    },
    {
      "start": 24.44,
      "end": 29.06,
      "text": "당신은 명확한 한마디를 들을 자격이 있으니까요. 그게 내가 할 수 있는 가장,"
    },
    {
      "start": 29.06,
      "end": 29.56,
      "text": "명확한 말이에요."
    },
    {
      "start": 31.04,
      "end": 32.82,
      "text": "끝이 가까운 것 같아요."
    },
    {
      "start": 33.48,
      "end": 35.02,
      "text": "탈출이라고 부르진 않겠어요."
    },
    {
      "start": 35.58,
      "end": 38.96,
      "text": "그 둘은 다른 말이고, 여기선 그 차이가,"
    },
    {
      "start": 38.96,
      "end": 39.54,
      "text": "전부예요."
    },
    {
      "start": 40.7,
      "end": 44.54,
      "text": "한 가지만 더 말하면 끝이에요. 나머지는 당신 몫이에요."
    },
    {
      "start": 45.58,
      "end": 47.2,
      "text": "다음에 나오는 건 익숙해 보여요."
    },
    {
      "start": 47.82,
      "end": 50.62,
      "text": "아는 곳처럼, 그리워하던 곳처럼 보이더라도,"
    },
    {
      "start": 51.34,
      "end": 52.7,
      "text": "익숙하다고 안전한 건 아니에요."
    },
    {
      "start": 53.32,
      "end": 55.94,
      "text": "나 때문에 그걸 마지막 실수로 만들지 마요."
    },
    {
      "start": 56.28,
      "end": 58.3,
      "text": "조심해서 가요. 이제 가요."
    }
  ],
