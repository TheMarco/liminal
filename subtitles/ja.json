    },
    {
      "start": 27.1,
      "end": 27.6,
      "text": "そこに……"
    }
  ],
  "res://videos/tapes/short_random_12.ogv": [
    {
      "start": 1.01,
      "end": 3.89,
      "text": "どうして、いつも天井があるんだろう。"
    },
    {
      "start": 6.47,
      "end": 7.11,
      "text": "馬鹿げているだろう。"
    },
    {
      "start": 8.51,
      "end": 9.61,
      "text": "でも、考えてみてくれ。"
    },
    {
      "start": 10.23,
      "end": 12.67,
      "text": "ここは、他のどんな法則にも従わない。"
    },
    {
      "start": 13.41,
      "end": 14.03,
      "text": "部屋は変わる。"
    },
    {
      "start": 14.87,
      "end": 15.69,
      "text": "廊下は伸びる。"
    },
    {
      "start": 16.49,
      "end": 17.23,
      "text": "ドアは動く。"
    },
    {
      "start": 18.47,
      "end": 19.91,
      "text": "でも、天井だけは必ずある。"
    },
    {
      "start": 23.08,
      "end": 25.14,
      "text": "何かが入ってこないように、あるんじゃないのかも。"
    },
    {
      "start": 26.96,
      "end": 28.7,
      "text": "私たちを閉じ込めるためかもしれない。"
    }
  ],
  "res://videos/tapes/short_random_13.ogv": [
    {
      "start": 0.14,
      "end": 1.76,
      "text": "昨日、これを覆った。"
    },
    {
      "start": 3.22,
      "end": 4.68,
      "text": "外には何もない。"
    },
    {
      "start": 5.24,
      "end": 6.06,
      "text": "闇ですらない。"
    },
    {
      "start": 6.94,
      "end": 7.46,
      "text": "何も。"
    },
    {
      "start": 9.2,
      "end": 13.58,
      "text": "だが昨夜、ガラスを叩く音で目が覚めた。"
    },
    {
      "start": 16.03,
      "end": 17.05,
      "text": "見なかった。"
    },
    {
      "start": 18.67,
      "end": 20.05,
      "text": "やがて、音は止んだ。"
    },
    {
      "start": 22.15,
      "end": 23.85,
      "text": "今朝は、"
    },
    {
      "start": 25.75,
      "end": 27.53,
      "text": "こちら側から、音がし始めた。"
    }
  ],
  "res://videos/tapes/short_random_14.ogv": [
    {
      "start": 0.34,
      "end": 2.6,
      "text": "この壁は、毎晩音を立てる。"
    },
    {
      "start": 3.18,
      "end": 6.6,
      "text": "引っかく音でも、配管でも、そういう音じゃない。"
    },
    {
      "start": 7.32,
      "end": 11.08,
      "text": "人でいっぱいの部屋のような音だ。"
    },
    {
      "start": 12.38,
      "end": 13.18,
      "text": "くぐもった声、"
    },
    {
      "start": 14.12,
      "end": 14.94,
      "text": "動く椅子、"
    },
    {
      "start": 15.48,
      "end": 16.5,
      "text": "時には笑い声。"
    },
    {
      "start": 17.74,
      "end": 20.0,
      "text": "この壁は、厚さが二メートル近くある。"
    },
    {
      "start": 23.53,
      "end": 24.23,
      "text": "そして昨日、"
    },
    {
      "start": 26.38,
      "end": 28.92,
      "text": "向こうの誰かに、静かにしろと言われた。"
    }
  ],
  "res://videos/tapes/tape_02.ogv": [
    {
      "start": 0.21,
      "end": 1.49,
      "text": "記録、一。"
    },
    {
      "start": 2.99,
      "end": 4.71,
      "text": "三月十四日、金曜日。"
    },
    {
      "start": 4.87,
      "end": 8.37,
      "text": "午後十一時四十分。時計が正しければ。いつも正しいが。"
    },
    {
      "start": 9.97,
      "end": 10.43,
      "text": "私は、"
    },
    {
      "start": 10.43,
      "end": 12.01,
      "text": "エヴリン・クロス博士。記録のために名乗っておく。"
    },
    {
      "start": 12.73,
      "end": 14.83,
      "text": "誰のための記録かは、まだ分からない。"
    },
    {
      "start": 15.13,
      "end": 16.69,
      "text": "業務用エレベーターで降りた。"
    },
    {
      "start": 16.91,
      "end": 19.13,
      "text": "地下室に着くには、長すぎる時間だった。"
    },
    {
      "start": 19.61,
      "end": 21.31,
      "text": "ドアが開くと、広いフロアがあった。"
    },
    {
      "start": 21.99,
      "end": 26.05,
      "text": "カーペット、照明、電源。すべて稼働し、整備されていた。だが人は、"
    },
    {
      "start": 26.05,
      "end": 26.55,
      "text": "どこにもいない。"
    },
    {
      "start": 27.09,
      "end": 28.45,
      "text": "二度、呼びかけた。"
    },
    {
      "start": 29.23,
      "end": 29.91,
      "text": "返事はなかった。"
    },
    {
      "start": 30.43,
      "end": 32.57,
      "text": "単純に考えれば、図面にない建物だ。"
    },
    {
      "start": 33.05,
      "end": 36.55,
      "text": "古い基礎、封鎖された階層。都市はいつも何かを埋めている。"
    },
    {
      "start": 37.21,
      "end": 41.17,
      "text": "ただ、二十分まっすぐ歩いても、外壁に着かなかった。"
    },
    {
      "start": 41.17,
      "end": 43.11,
      "text": "上の建物は、幅が八十メートルしかない。"
    },
    {
      "start": 43.93,
      "end": 44.85,
      "text": "自分で測った。"
    },
    {
      "start": 45.35,
      "end": 48.57,
      "text": "つまり、その説明は間違いだ。他の説明はまだない。"
    },
    {
      "start": 48.83,
      "end": 49.41,
      "text": "それでいい。"
    },
    {
      "start": 49.71,
      "end": 51.37,
      "text": "大抵の……大抵の説明は、間違いから始まる。"
    },
    {
      "start": 51.77,
      "end": 53.77,
      "text": "確かめられることは、すべて記録するつもりだ。"
    },
    {
      "start": 53.77,
      "end": 56.13,
      "text": "誰かがこの記録を見つけたら、"
    },
    {
      "start": 56.79,
      "end": 57.95,
      "text": "私の出発点から始めてほしい。"
    }
  ],
  "res://videos/tapes/tape_03.ogv": [
    {
      "start": 0,
      "end": 0.88,
      "text": "記録、六。"
    },
    {
      "start": 1.34,
      "end": 2.1,
      "text": "六だと思う。"
    },
    {
      "start": 3.16,
      "end": 4.86,
      "text": "残す価値のあるものでは、六本目だ。"
    },
    {
      "start": 6.36,
      "end": 8.3,
      "text": "十五日、土曜日。"
    },
    {
      "start": 9.18,
      "end": 11.42,
      "text": "最後に確認した時は、十五日だった。"
    },
    {
      "start": 11.64,
      "end": 14.52,
      "text": "確認してから時間が経ちすぎたのは、認める。"
    },
    {
      "start": 15.3,
      "end": 16.82,
      "text": "ここでは、すべてが動き続けている。"
    },
    {
      "start": 17.62,
      "end": 18.86,
      "text": "照明は予定通りに切り替わる。"
    },
    {
      "start": 19.58,
      "end": 20.92,
      "text": "誰もいないのに、音楽が流れる。"
    },
    {
      "start": 21.14,
      "end": 22.82,
      "text": "繰り返しが、分かるようになってきた。"
    },
    {
      "start": 23.48,
      "end": 25.72,
      "text": "今朝、機械が私に釣り銭を出した。"
    },
    {
      "start": 26.22,
      "end": 27.04,
      "text": "ぴったりの額だった。"
    },
    {
      "start": 27.04,
      "end": 29.9,
      "text": "金を払った人間など、どこにもいないのに。"
    },
    {
      "start": 30.4,
      "end": 31.58,
      "text": "最初は、放棄された場所だと思った。"
    },
    {
      "start": 32.16,
      "end": 34.92,
      "text": "人々が急いで去り、仕組みだけが動き続けている。"
    },
    {
      "start": 35.54,
      "end": 36.58,
      "text": "安心できる仮説だ。"
    },
    {
      "start": 37.24,
      "end": 38.6,
      "text": "だが、放棄された場所は朽ちる。"
    },
    {
      "start": 39.2,
      "end": 41.82,
      "text": "埃、湿気、故障。ここでは何も朽ちていない。"
    },
    {
      "start": 43.0,
      "end": 44.66,
      "text": "朽ちることを、許された形跡もない。"
    },
    {
      "start": 45.34,
      "end": 47.86,
      "text": "使われる練習をしている場所、というほうが近い。"
    },
    {
      "start": 48.8,
      "end": 53.2,
      "text": "決して来ない人々のために、延々と練習している。それなら、"
    },
    {
      "start": 53.2,
      "end": 54.36,
      "text": "初めから、誰もいなかったことになる。"
    },
    {
      "start": 54.42,
      "end": 55.42,
      "text": "証明はできない。"
    },
    {
      "start": 55.44,
      "end": 57.7,
      "text": "証明できないことは、記録に明記しておきたい。"
    }
  ],
  "res://videos/tapes/tape_04.ogv": [
    {
      "start": 0,
      "end": 3.44,
      "text": "記録、九。十七日、月曜日。"
    },
    {
      "start": 3.5,
      "end": 4.52,
      "text": "地図を描き始めた。"
    },
    {
      "start": 5.46,
      "end": 9.64,
      "text": "部屋、分岐、距離、呼んだエレベーターが来るまでの、"
    },
    {
      "start": 9.64,
      "end": 10.14,
      "text": "時間。"
    },
    {
      "start": 10.56,
      "end": 14.28,
      "text": "ここに法則があるなら……あるはずだ……それは、"
    },
    {
      "start": 14.28,
      "end": 14.78,
      "text": "数字に現れる。"
    },
    {
      "start": 15.2,
      "end": 17.48,
      "text": "ここで頼れるのは、エレベーターだけだ。"
    },
    {
      "start": 18.12,
      "end": 20.92,
      "text": "呼べば来る。行くべき場所へ行く。"
    },
    {
      "start": 21.08,
      "end": 24.14,
      "text": "一度も怖いと思ったことがない。他のものには、そう言えない。"
    },
    {
      "start": 24.64,
      "end": 27.64,
      "text": "四十回計った。四十回とも同じ結果だ。"
    },
    {
      "start": 27.64,
      "end": 28.58,
      "text": "問題は、"
    },
    {
      "start": 30.41,
      "end": 31.81,
      "text": "私の背後にある。"
    },
    {
      "start": 32.51,
      "end": 36.21,
      "text": "廊下を歩き、描き、同じ道を戻ると、その図は、"
    },
    {
      "start": 36.21,
      "end": 36.71,
      "text": "間違っている。"
    },
    {
      "start": 37.11,
      "end": 38.07,
      "text": "大きな違いじゃない。"
    },
    {
      "start": 38.47,
      "end": 39.41,
      "text": "決して、大きくは違わない。"
    },
    {
      "start": 39.87,
      "end": 43.19,
      "text": "ドアが一つ少ない。曲がり角が記録より手前にある。"
    },
    {
      "start": 43.47,
      "end": 44.85,
      "text": "小さな、気のせいにできる違い。"
    },
    {
      "start": 45.47,
      "end": 48.79,
      "text": "見ていない間にここが自らを書き換えるのか、それとも私という測定器が、"
    },
    {
      "start": 48.79,
      "end": 51.93,
      "text": "壊れかけているのか。どちらが怖いか、分からない。"
    },
    {
      "start": 53.25,
      "end": 55.17,
      "text": "それでも地図を描いている。"
    },
    {
      "start": 56.35,
      "end": 59.41,
      "text": "地図は間違っている。でも、やめるほうが怖い。"
    }
  ],
  "res://videos/tapes/tape_05.ogv": [
    {
      "start": 0,
      "end": 0.54,
      "text": "記録。"
    },
    {
      "start": 1.52,
      "end": 2.92,
      "text": "番号を付けるのはやめた。"
    },
    {
      "start": 3.26,
      "end": 6.6,
      "text": "二十日か、二十二日だ。"
    },
    {
      "start": 6.92,
      "end": 10.82,
      "text": "時計とメモが食い違っている。どちらも信じていたのに。"
    },
    {
      "start": 11.42,
      "end": 13.86,
      "text": "仕事を始めて以来、ずっと両方を信じてきた。"
    },
    {
      "start": 14.88,
      "end": 16.84,
      "text": "確実に言えることだけを話す。"
    },
    {
      "start": 17.22,
      "end": 21.6,
      "text": "カメラでは前回の録画から十九時間。体の感覚では、何日も経った。"
    },
    {
      "start": 22.44,
      "end": 26.0,
      "text": "その間に四回食べて、二回眠った。たぶん。"
    },
    {
      "start": 26.92,
      "end": 29.68,
      "text": "同じ十九時間には、収まらない数だ。"
    },
    {
      "start": 30.3,
      "end": 34.38,
      "text": "十九時間では収まらないほど歩いた記憶もある。何時間もの廊下が、"
    },
    {
      "start": 34.38,
      "end": 35.52,
      "text": "今でも目に浮かぶ。"
    },
    {
      "start": 36.52,
      "end": 40.58,
      "text": "エレベーターは距離を下っていると思っていた。実在する何かの、"
    },
    {
      "start": 40.58,
      "end": 41.66,
      "text": "階層を通って。"
    },
    {
      "start": 42.36,
      "end": 44.86,
      "text": "今は、距離の中を移動しているとは思えない。"
    },
    {
      "start": 45.22,
      "end": 47.8,
      "text": "では何の中なのか、証拠はない。"
    },
    {
      "start": 48.64,
      "end": 49.14,
      "text": "何も。"
    },
    {
      "start": 49.54,
      "end": 51.96,
      "text": "これ以上話す前に、そのことは記録しておきたい。"
    },
    {
      "start": 52.72,
      "end": 53.66,
      "text": "ただの感覚だ。"
    },
    {
      "start": 53.9,
      "end": 54.86,
      "text": "それだけだ。"
    },
    {
      "start": 55.46,
      "end": 59.8,
      "text": "そして最近、事実より先に、感覚がやってくる。"
    }
  ],
  "res://videos/tapes/tape_43.ogv": [
    {
      "start": 0,
      "end": 2.02,
      "text": "今日、記憶にある部屋を見つけた。"
    },
    {
      "start": 2.62,
      "end": 3.46,
      "text": "見覚えがあるんじゃない。"
    },
    {
      "start": 4.2,
      "end": 4.76,
      "text": "覚えていたんだ。"
    },
    {
      "start": 5.72,
      "end": 8.54,
      "text": "三番目の机の傷。釣り針のような形。"
    },
    {
      "start": 9.1,
      "end": 11.36,
      "text": "ドアのそばのコート掛け。一つだけ上に曲がっている。"
    },
    {
      "start": 12.02,
      "end": 13.74,
      "text": "見る前から、知っていた。"
    },
    {
      "start": 15.15,
      "end": 18.37,
      "text": "ドアを開ける前に、その部屋を描けたはずだ。窓から差し込む、"
    },
    {
      "start": 18.37,
      "end": 19.19,
      "text": "光まで。"
    },
    {
      "start": 20.15,
      "end": 24.05,
      "text": "私は、その部屋があり得る場所から六百マイルも離れた土地で育った。"
    },
    {
      "start": 25.13,
      "end": 27.25,
      "text": "確かめるために、メモを二度読み返した。"
    },
    {
      "start": 29.98,
      "end": 31.72,
      "text": "私の子供時代は、別の場所にあった。"
    },
    {
      "start": 31.76,
      "end": 33.98,
      "text": "自分についての事実なのに、確認しなければならなかった。"
    },
    {
      "start": 34.36,
      "end": 36.4,
      "text": "少し、その意味を考えてほしい。私は考えた。"
    },
    {
      "start": 41.88,
      "end": 45.42,
      "text": "ここが私の頭を読んで、それをもとに作っているのか。それとも、"
    },
    {
      "start": 45.42,
      "end": 48.82,
      "text": "何かを書き込んでいるのか。私の記憶を、工事現場にして。"
    },
    {
      "start": 49.3,
      "end": 50.24,
      "text": "どちらかは、分からない。"
    },
    {
      "start": 50.62,
      "end": 51.62,
      "text": "知りようがない。"
    },
    {
      "start": 51.96,
      "end": 53.08,
      "text": "だからこそ、成り立つんだ。"
    },
    {
      "start": 53.66,
      "end": 55.74,
      "text": "昔は、どの記憶が自分のものか分かっていた。"
    },
    {
      "start": 56.56,
      "end": 58.42,
      "text": "今の言葉を、過去形にしてはいけないはずだ。"
    }
  ],
  "res://videos/tapes/tape_44.ogv": [
    {
      "start": 0.05,
      "end": 1.45,
      "text": "今回は実用的な話だ。"
    },
    {
      "start": 2.29,
      "end": 5.15,
      "text": "私を追っているなら、再生が終わったら止めて、もう一度見てくれ。"
    },
    {
      "start": 6.11,
      "end": 7.47,
      "text": "ここには、他にもいる。"
    },
    {
      "start": 7.93,
      "end": 9.53,
      "text": "もう一体は見ただろう。"
    },
    {
      "start": 10.11,
      "end": 11.97,
      "text": "まだなら、そのうち見る。"
    },
    {
      "start": 15.28,
      "end": 18.16,
      "text": "姿の説明はしない。正確に伝えられる自信がないからだ。"
    },
    {
      "start": 18.16,
      "end": 20.42,
      "text": "不正確な説明は、人を傷つける。"
    },
    {
      "start": 20.9,
      "end": 25.96,
      "text": "確認したことだけ話す。距離と出入口は時間を稼げる。でも、"
    },
    {
      "start": 25.96,
      "end": 26.54,
      "text": "安全にはならない。"
    },
    {
      "start": 27.5,
      "end": 29.54,
      "text": "生き物のように、興味を失ってはくれない。"
    },
    {
      "start": 29.54,
      "end": 30.36,
      "text": "光だ。"
    },
    {
      "start": 31.02,
      "end": 32.44,
      "text": "携帯電話の光。"
    },
    {
      "start": 32.94,
      "end": 34.08,
      "text": "あれらは、光の中には入らない。"
    },
    {
      "start": 34.3,
      "end": 35.92,
      "text": "光の縁に立って、待っている。"
    },
    {
      "start": 36.46,
      "end": 38.74,
      "text": "だが、十分長く照らすと、退くのではなく、"
    },
    {
      "start": 39.28,
      "end": 39.9,
      "text": "消える。"
    },
    {
      "start": 40.32,
      "end": 41.3,
      "text": "この目で見た。"
    },
    {
      "start": 43.38,
      "end": 44.56,
      "text": "私がやった。"
    },
    {
      "start": 45.35,
      "end": 47.43,
      "text": "以前は、あれらについて別のことを信じていた。"
    },
    {
      "start": 47.83,
      "end": 48.61,
      "text": "もっともらしいことを。"
    },
    {
      "start": 49.21,
      "end": 51.77,
      "text": "今と同じように、事実として記録した。"
    },
    {
      "start": 53.21,
      "end": 56.35,
      "text": "間違っていた。そして、代償を払ったのは私ではなかった。"
    },
    {
      "start": 57.25,
      "end": 58.79,
      "text": "必要になる前に、明かりを確かめておけ。"
    },
    {
      "start": 58.79,
      "end": 59.87,
      "text": "後では遅い。"
    }
  ],
  "res://videos/tapes/tape_45.ogv": [
    {
      "start": 0,
      "end": 3.42,
      "text": "説明の一覧を、順番に書き留めてきた。"
    },
    {
      "start": 3.6,
      "end": 6.16,
      "text": "もう抱え込まずに済むように、読み上げる。"
    },
    {
      "start": 6.7,
      "end": 7.56,
      "text": "死後の世界。"
    },
    {
      "start": 9.02,
      "end": 10.84,
      "text": "どこかに実在する建造物。"
    },
    {
      "start": 11.48,
      "end": 14.86,
      "text": "独自の法則を持つ、まったく別の場所の夢。"
    },
    {
      "start": 15.46,
      "end": 17.42,
      "text": "どれも、しばらくは証拠と一致した。"
    },
    {
      "start": 17.52,
      "end": 18.6,
      "text": "例外なく、すべて。"
    },
    {
      "start": 18.66,
      "end": 19.42,
      "text": "それが問題なんだ。"
    },
    {
      "start": 20.24,
      "end": 23.94,
      "text": "ある仮説を採用した途端、ここはその証拠を生み始める。"
    },
    {
      "start": 24.24,
      "end": 24.86,
      "text": "惜しみなく。"
    },
    {
      "start": 25.38,
      "end": 25.96,
      "text": "ふんだんに。"
    },
    {
      "start": 26.62,
      "end": 29.26,
      "text": "私に同意し、それを楽しんでいるかのように。"
    },
    {
      "start": 30.02,
      "end": 33.92,
      "text": "私が都合のいいものしか見ない、欠陥のある測定器なのか、"
    },
    {
      "start": 34.46,
      "end": 35.68,
      "text": "信頼できないものなのか。"
    },
    {
      "start": 36.6,
      "end": 41.42,
      "text": "あるいは、ここが信念に証拠で応えるのか。そのほうが悪い。なぜなら、"
    },
    {
      "start": 41.42,
      "end": 44.92,
      "text": "見つけた答えはすべて、私のために注文通り育てられたことになる。"
    },
    {
      "start": 45.24,
      "end": 46.42,
      "text": "だから、説明するのはやめた。"
    },
    {
      "start": 47.34,
      "end": 48.7,
      "text": "観察は、やめていない。"
    },
    {
      "start": 48.84,
      "end": 52.38,
      "text": "今も数え、測り、記録する。だが、説明はしない。"
    },
    {
      "start": 53.8,
      "end": 57.4,
      "text": "この二つには違いがある。その違いこそが、"
    },
    {
      "start": 57.4,
      "end": 59.0,
      "text": "私をここまで生かしてきたんだと思う。"
    }
  ],
  "res://videos/tapes/tape_46.ogv": [
    {
      "start": 0,
      "end": 0.88,
      "text": "日付は、なし。"
    },
    {
      "start": 1.56,
      "end": 5.16,
      "text": "日付は手放した。覚えておくより、手放すほうがずっと、"
    },
    {
      "start": 5.16,
      "end": 5.72,
      "text": "楽だった。"
    },
    {
      "start": 6.7,
      "end": 8.06,
      "text": "新しい報告がある。"
    },
    {
      "start": 8.92,
      "end": 11.32,
      "text": "今では、次の場所に着く前に、その音が聞こえる。"
    },
    {
      "start": 11.92,
      "end": 12.66,
      "text": "何日も前から。"
    },
    {
      "start": 13.42,
      "end": 14.64,
      "text": "先に、こちらへ漏れてくる。"
    },
    {
      "start": 15.48,
      "end": 16.68,
      "text": "今回は、水だった。"
    },
    {
      "start": 17.26,
      "end": 21.12,
      "text": "最初は壁の向こうの滴る音。それから、水の流れ。"
    },
    {
      "start": 22.16,
      "end": 25.88,
      "text": "次に匂い。通った時には、からからに乾いていた部屋で。"
    },
    {
      "start": 26.52,
      "end": 29.92,
      "text": "エレベーターが来る頃には、水はもう現実になっていた。"
    },
    {
      "start": 30.44,
      "end": 34.04,
      "text": "以前は、別々の場所が上下に積まれていると思っていた。そして、"
    },
    {
      "start": 34.04,
      "end": 36.06,
      "text": "エレベーターが、その継ぎ目なのだと。"
    },
    {
      "start": 36.74,
      "end": 38.4,
      "text": "今は、継ぎ目がほころんでいるのだと思う。"
    },
    {
      "start": 39.22,
      "end": 41.24,
      "text": "あるいは、初めから継ぎ目などなかったのか。"
    },
    {
      "start": 41.84,
      "end": 44.58,
      "text": "一つの場所が、違う部屋をまとっている。"
    },
    {
      "start": 45.48,
      "end": 46.82,
      "text": "何一つ、証明はできない。"
    },
    {
      "start": 47.52,
      "end": 49.98,
      "text": "テープのたびに、そう言っていることに気づく。"
    },
    {
      "start": 50.24,
      "end": 51.34,
      "text": "証明はできない。"
    },
    {
      "start": 52.02,
      "end": 55.16,
      "text": "以前ほど、気にならなくなった。そのことも不安に思うべき、"
    },
    {
      "start": 55.16,
      "end": 55.66,
      "text": "なんだろう。"
    },
    {
      "start": 56.34,
      "end": 57.1,
      "text": "でも、気にならない。"
    }
  ],
  "res://videos/tapes/tape_47.ogv": [
    {
      "start": 0.14,
      "end": 1.62,
      "text": "今日、テープを見つけた。"
    },
    {
      "start": 2.14,
      "end": 3.16,
      "text": "引き出し、いっぱいに。"
    },
    {
      "start": 3.64,
      "end": 5.98,
      "text": "私の声、私の部屋。この部屋、このテーブルだ。"
    },
    {
      "start": 6.94,
      "end": 8.76,
      "text": "録った記憶はない。"
    },
    {
      "start": 9.22,
      "end": 11.22,
      "text": "それだけなら、疲労で片づけられた。"
    },
    {
      "start": 11.84,
      "end": 13.96,
      "text": "最近は、もっとひどいことも疲労で片づけてきた。"
    },
    {
      "start": 15.56,
      "end": 17.94,
      "text": "一本には、まだ言っていないことが録られていた。"
    },
    {
      "start": 18.5,
      "end": 20.26,
      "text": "今夜、話すつもりだったことだ。"
    },
    {
      "start": 20.6,
      "end": 24.72,
      "text": "この録画で。まだ選んでいなかった言葉で。二度、確かめた。"
    },
    {
      "start": 24.72,
      "end": 25.94,
      "text": "録画ボタンを押す前に。"
    },
    {
      "start": 25.94,
      "end": 27.04,
      "text": "それは、"
    },
    {
      "start": 28.43,
      "end": 29.53,
      "text": "ここに置いてある。"
    },
    {
      "start": 30.81,
      "end": 32.19,
      "text": "だから代わりに、君に話しかけよう。"
    },
    {
      "start": 33.05,
      "end": 34.37,
      "text": "私の後を来る、誰かに。"
    },
    {
      "start": 35.25,
      "end": 39.17,
      "text": "見えない場所に座って、私が彼女の記録を見たように、これを見ている誰かに。"
    },
    {
      "start": 40.43,
      "end": 40.93,
      "text": "いや、私の。"
    },
    {
      "start": 42.27,
      "end": 44.79,
      "text": "君だけが、まだ私に崩せていない仮説だ。"
    },
    {
      "start": 45.43,
      "end": 49.03,
      "text": "君に警告を残しているのか、私に残された警告を繰り返しているのか、"
    },
    {
      "start": 49.03,
      "end": 51.69,
      "text": "分からない。この一文に至るまで、一言一句。"
    },
    {
      "start": 52.47,
      "end": 55.69,
      "text": "その違いが、私以外の誰かに意味を持つとは思えなくなった。"
    },
    {
      "start": 56.13,
      "end": 57.81,
      "text": "初めから、意味などなかったのかもしれない。"
    }
  ],
  "res://videos/tapes/tape_48.ogv": [
    {
      "start": 0.05,
      "end": 2.23,
      "text": "君に説明を与えるつもりはない。"
    },
    {
      "start": 3.09,
      "end": 4.19,
      "text": "私にもないからだ。"
    },
    {
      "start": 4.95,
      "end": 8.45,
      "text": "それを嘆くのはやめた。思うより、ずっと時間がかかった。"
    },
    {
      "start": 10.5,
      "end": 14.34,
      "text": "これを最後の記録にするつもりだ。だから、はっきり言う。"
    },
    {
      "start": 15.56,
      "end": 19.86,
      "text": "君がここにいるなら、他のすべてがなろうとしていた場所へ、"
    },
    {
      "start": 19.86,
      "end": 20.36,
      "text": "たどり着いたということだ。"
    },
    {
      "start": 21.74,
      "end": 23.96,
      "text": "怖がらせたいんじゃない。"
    },
    {
      "start": 24.44,
      "end": 29.06,
      "text": "君には、飾りのない言葉を聞く権利がある。今のが、私に言える最も、"
    },
    {
      "start": 29.06,
      "end": 29.56,
      "text": "率直な言葉だ。"
    },
    {
      "start": 31.04,
      "end": 32.82,
      "text": "終わりが近いと思う。"
    },
    {
      "start": 33.48,
      "end": 35.02,
      "text": "脱出とは呼ばない。"
    },
    {
      "start": 35.58,
      "end": 38.96,
      "text": "別の言葉だ。そしてここでは、その違いが、"
    },
    {
      "start": 38.96,
      "end": 39.54,
      "text": "すべてなんだ。"
    },
    {
      "start": 40.7,
      "end": 44.54,
      "text": "あと一つで終わりにする。その先は、君のものだ。"
    },
    {
      "start": 45.58,
      "end": 47.2,
      "text": "次にあるものは、見慣れた姿をしている。"
    },
    {
      "start": 47.82,
      "end": 50.62,
      "text": "知っている場所、懐かしい場所に見えても、"
    },
    {
      "start": 51.34,
      "end": 52.7,
      "text": "見慣れていることと、安全なことは違う。"
    },
    {
      "start": 53.32,
      "end": 55.94,
      "text": "私を信じたせいで、それが最後の過ちにならないように。"
    },
    {
      "start": 56.28,
      "end": 58.3,
      "text": "気をつけて。さあ、行って。"
    }
  ],
  "res://videos/outro/outside.ogv": [],
  "res://videos/intro/startup.ogv": []
}
